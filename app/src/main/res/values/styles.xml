<resources>

    //**************************************************************Theme******************************************************************************//

    <!-- 亮色主题 -->
    <style name="AppTheme.Light" parent="Base.AppTheme">
        <item name="actionBarStyle">@style/AppTheme.AppBarOverlay.Light</item>
    </style>

    <!-- 暗色主题 -->
    <style name="AppTheme.Dark" parent="Base.AppTheme">
        <item name="actionBarStyle">@style/AppTheme.AppBarOverlay.Dark</item>
    </style>

    <!-- 透明主题 -->
    <style name="AppTheme.Transparent" parent="Base.AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Welcome主题 -->
    <style name="AppTheme.Welcome" parent="Base.AppTheme">
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/accent</item>
        <!-- M3 完整默认色板:默认种子(md_theme_day/night_accent)预生成,与 AppColorScheme 运行时派生同源。
             API 30+ 由 AppThemeInstaller 覆盖这些资源;旧系统 attr 控件用此静态兜底。 -->
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/m3_inverse_primary</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorSurfaceBright">@color/m3_surface_bright</item>
        <item name="colorSurfaceDim">@color/m3_surface_dim</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <!-- 文字色 attr 显式接管:Theme.Material3 默认指向库内 selector(m3_dark/default_default_color_*),
             不经过 app token,运行时表覆盖不到;此三色 + 弹窗列表项/提示是 app 文字色的全部通路 -->
        <item name="android:textColorPrimary">@color/text_primary_color</item>
        <item name="android:textColorSecondary">@color/text_secondary_color</item>
        <item name="android:textColorTertiary">@color/text_secondary_color</item>
        <item name="android:textColorPrimaryInverse">@color/m3_inverse_on_surface</item>
        <item name="android:textColorSecondaryInverse">@color/m3_inverse_on_surface</item>
        <item name="android:textColorTertiaryInverse">@color/m3_inverse_on_surface</item>
        <item name="android:textColorPrimaryDisableOnly">@color/m3_on_surface</item>
        <item name="android:textColorAlertDialogListItem">@color/m3_on_surface</item>
        <item name="android:textColorHint">@color/m3_on_surface_variant</item>
        <item name="tabStyle">@style/Widget.App.TabLayout</item>
        <!-- textInputStyle 全局挂接 OutlinedBox+radius_m;chipStyle 不挂全局——Filter 变体做全局默认会让普通 action chip 也变成可勾选外观 -->
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="sliderStyle">@style/Widget.App.Slider</item>
        <item name="actionOverflowMenuStyle">@style/Style.PopupMenu</item>
        <item name="android:itemTextAppearance">@style/Style.MenuItemText</item>
        <item name="android:popupMenuStyle">@style/Style.PopupMenu</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 关闭 M3 默认的 elevation overlay tinting，避免 surface 自动染主色 -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- 形状体系:M3 五档 + M2 组件兼容属性 -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.ExtraLarge</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.ExtraLarge</item>
        <!-- 字体挂接:弹窗标题=Headline(22sp 真粗体),按钮=Label(14sp medium),超大数字/空状态=Display(32sp 真粗体) -->
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.Display</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Subtitle</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.Label</item>
        <!-- BottomSheet 统一形状入口(容器色由 applyAppSheetBackground 代码锚定) -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>

    <style name="AppTheme.AppBarOverlay.Light" parent="ThemeOverlay.Material3.Light">
        <item name="colorAccent">@color/md_grey_900</item>
        <item name="colorPrimary">@color/md_grey_900</item>
    </style>

    <style name="AppTheme.AppBarOverlay.Dark" parent="ThemeOverlay.Material3.Dark">
        <item name="colorAccent">@color/md_grey_50</item>
        <item name="colorPrimary">@color/md_grey_50</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light">
        <item name="overlapAnchor">false</item>
        <item name="colorAccent">@color/md_grey_900</item>
    </style>

    <style name="Spinner" parent="ThemeOverlay.Material3" />

    <!-- 全局 TabLayout 样式：指示器/选中文字用 accent，避免 M3 默认紫 -->
    <style name="Widget.App.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/accent</item>
        <item name="tabSelectedTextColor">@color/accent</item>
        <item name="tabTextColor">@color/secondaryText</item>
        <item name="tabRippleColor">@color/transparent</item>
    </style>

    <!-- Surface-owned tabs: foreground is readable against the dialog/page surface. -->
    <style name="Widget.App.TabLayout.Surface" parent="Widget.App.TabLayout" />

    <style name="Widget.App.BottomNavigation.ActiveIndicator.Transparent"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/transparent</item>
    </style>

    <style name="ShapeAppearanceLegadoAudioPlayFab">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- E-ink:把关键 M3 attr 压成黑白灰,与 AppColorScheme 的 eink 表同源(attr 控件兜底) -->
    <style name="ThemeOverlay.App.EInk" parent="">
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondaryContainer">#FFEBEBEB</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
    </style>

    <!-- 平台 NumberPicker 的 Holo 分隔线靠 colorControlNormal 着色,透明化=去分隔线(M3 无分隔线语义) -->
    <style name="ThemeOverlay.App.NumberPicker" parent="">
        <item name="android:colorControlNormal">@color/transparent</item>
    </style>

    <!-- M3 五档形状:全 app 唯一圆角来源 -->
    <style name="ShapeAppearance.App.ExtraSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xs</item>
    </style>
    <style name="ShapeAppearance.App.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>
    <style name="ShapeAppearance.App.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>
    <style name="ShapeAppearance.App.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>
    <style name="ShapeAppearance.App.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <!-- 字体体系:对齐 M3 type scale,落在既有 text_* token 上 -->
    <!-- Headline 用真粗体(Roboto Bold 700),而非 sans-serif-medium 的假粗,强化 M3 Expressive 字阶层级 -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Display" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.App.Subtitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.App.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
    <style name="TextAppearance.App.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============ 组件模板族:全 app 组件唯一样式来源(P2-P5 逐处替换消费) ============ -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button" />
    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton" />
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton" />
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton" />
    <!-- 紧凑描边钮:阅读面板/编辑页行内按钮用,压掉 M3 默认最小尺寸与大写 -->
    <style name="Widget.App.Button.Outlined.Compact">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Small</item>
    </style>

    <!-- Slider 统一形态:圆点拇指去竖杠、去两侧缺口、去尾端停止点;轨道厚度用 M3 默认 -->
    <style name="Widget.App.Slider" parent="Widget.Material3.Slider">
        <item name="thumbWidth">20dp</item>
        <item name="thumbHeight">20dp</item>
        <item name="thumbTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="cardBackgroundColor">@color/background_card</item>
    </style>
    <style name="Widget.App.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="cardBackgroundColor">@color/background_card</item>
    </style>
    <style name="Widget.App.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="strokeColor">@color/m3_outline_variant</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.App.ExtraLarge</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.SheetTop</item>
    </style>
    <!-- sheet 只圆顶部两角 -->
    <style name="ShapeAppearanceOverlay.App.SheetTop" parent="">
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    //**********System Style******************//

    <style name="Style.NavigationView" parent="android:Widget">
        <item name="android:listPreferredItemHeightSmall">44dp</item>
    </style>

    <style name="Style.Toolbar.NoPadding" parent="Widget.Material3.Toolbar">
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>

    <style name="Style.MenuItemText" parent="@android:style/TextAppearance.Widget.IconMenu.Item">
        <item name="android:textColor">@color/menu_color_default</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Style.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">3dp</item>
        <item name="android:listPreferredItemHeightSmall">48dp</item>
        <item name="android:listPreferredItemPaddingStart">16dp</item>
        <item name="android:listPreferredItemPaddingEnd">16dp</item>
    </style>

    <style name="Activity.Permission" parent="Base.AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ToolbarTitle" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
    </style>

    //*******************Widget Style**********************************//

    <!-- 管理列表项真卡片：六大规则管理/高亮/发现容器 共用。
         容器色运行时由 adapter 设 surfaceContainerLow(用户背景锚定);选中态=代码驱动 2dp 描边 -->
    <style name="Style.ItemManageCard" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">10dp</item>
        <item name="android:layout_marginVertical">3dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="cardBackgroundColor">@color/background_card</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">0dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Style.Shadow.Top" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/shadow_height</item>
        <item name="android:background">@drawable/bg_shadow_top</item>
    </style>

    <style name="Style.Shadow.Bottom" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/shadow_height</item>
        <item name="android:background">@drawable/bg_shadow_bottom</item>
    </style>


    <style name="Style.Line" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="Style.Text.Primary.Normal" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/font_size_normal</item>
        <item name="android:textColor">#000</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Style.Text.Primary.Normal.Wrap">
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="Style.Text.Second.Normal" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/font_size_normal</item>
        <item name="android:textColor">#676767</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Style.Text.Second.Normal.Wrap">
        <item name="android:layout_width">wrap_content</item>
    </style>

</resources>
